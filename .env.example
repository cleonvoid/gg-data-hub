# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GEMINI_MODEL (optional): overrides PRIMARY_MODEL in server/services/geminiService.ts.
# Leave unset to use the default, gemini-3.7-flash.
# GEMINI_MODEL=gemini-3.7-flash

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# PORT: injected by Cloud Run; defaults to 3000 locally
PORT=3000

# DATA_STORE: Data layer driver ('json' or 'firestore'). Defaults to 'json'.
DATA_STORE=json

# GOOGLE_APPLICATION_CREDENTIALS (optional, local dev only): path to a service-account
# JSON key for local Firestore access. Leave unset on Cloud Run, which uses the
# metadata server. Setting this to an invalid path breaks Firestore startup.
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# FIREBASE_PROJECT_ID (optional): overrides the projectId read from
# firebase-applet-config.json. Leave unset.
# FIREBASE_PROJECT_ID=

# FIRESTORE_DATABASE_ID (optional): overrides the firestoreDatabaseId read from
# firebase-applet-config.json. Leave unset. The unnamed default database is "(default)".
# FIRESTORE_DATABASE_ID=

# ALLOW_ANON_DEMO: Set to 'true' to allow unauthenticated preview/demo access (demo-only, must be false in production)
ALLOW_ANON_DEMO=false

# ALLOW_DEMO_SEED (optional, demo only): set to 'true' to enable POST /api/seed,
# which DELETES all data in the caller's organization before loading demo records.
# Leave unset in any deployment holding real data.
# ALLOW_DEMO_SEED=true

