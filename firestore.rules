rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Canonical Entities Collection
    match /canonicalEntities/{entityId} {
      allow get, list: if isSignedIn();
      allow create, update: if isSignedIn() && isValidId(entityId);
      allow delete: if isSignedIn();
    }

    // Raw Source Records Collection (Immutable attendee rows)
    match /rawRecords/{rawRecordId} {
      allow get, list: if isSignedIn();
      allow create, update: if isSignedIn() && isValidId(rawRecordId);
      allow delete: if isSignedIn();
    }

    // Entity Links Collection
    match /entityLinks/{linkId} {
      allow get, list: if isSignedIn();
      allow create, update: if isSignedIn() && isValidId(linkId);
      allow delete: if isSignedIn();
    }

    // Pending Suggestions Collection
    match /pendingSuggestions/{suggestionId} {
      allow get, list: if isSignedIn();
      allow create, update, delete: if isSignedIn() && isValidId(suggestionId);
    }

    // Rejections Collection
    match /rejections/{rejectionId} {
      allow get, list: if isSignedIn();
      allow create, update, delete: if isSignedIn() && isValidId(rejectionId);
    }

    // User Profile Documents
    match /users/{userId} {
      allow get: if isSignedIn();
      allow create, update: if isSignedIn() && request.auth.uid == userId;
      allow delete: if false;
    }

    // Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
