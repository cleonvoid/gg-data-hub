rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 1500;
    }

    // Resolves the caller's org from their profile doc. Costs one document read
    // per rule evaluation — acceptable here because it is the only way to scope
    // without custom claims, and the server (Admin SDK) bypasses rules entirely.
    function callerOrg() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.orgId;
    }

    function readableInOwnOrg() {
      return isSignedIn() && resource.data.orgId == callerOrg();
    }

    function creatingInOwnOrg() {
      return isSignedIn() && request.resource.data.orgId == callerOrg();
    }

    // Layer 1 — raw source records. IMMUTABLE BY DESIGN: the brief requires raw
    // data is never overwritten or discarded. Only the Admin SDK may mutate these.
    match /rawRecords/{rawRecordId} {
      allow get, list: if readableInOwnOrg();
      allow create: if creatingInOwnOrg() && isValidId(rawRecordId)
                    && request.resource.data.sourceFileId is string;
      allow update, delete: if false;
    }

    // Layer 2 — canonical entities (derived view over layer 1).
    match /canonicalEntities/{entityId} {
      allow get, list: if readableInOwnOrg();
      allow create: if creatingInOwnOrg() && isValidId(entityId)
                    && request.resource.data.canonicalName is string
                    && request.resource.data.canonicalName.size() <= 200;
      allow update: if readableInOwnOrg() && creatingInOwnOrg()
                    && request.resource.data.canonicalName is string
                    && request.resource.data.canonicalName.size() <= 200;
      allow delete: if false;
    }

    // Layer 3 — the merge/link audit trail. Append-only: rewriting why a merge
    // happened would destroy the provenance record the whole design rests on.
    match /entityLinks/{linkId} {
      allow get, list: if readableInOwnOrg();
      allow create: if creatingInOwnOrg() && isValidId(linkId);
      allow update, delete: if false;
    }

    match /pendingSuggestions/{suggestionId} {
      allow get, list: if readableInOwnOrg();
      allow create: if creatingInOwnOrg() && isValidId(suggestionId);
      allow update, delete: if readableInOwnOrg();
    }

    match /rejections/{rejectionId} {
      allow get, list: if readableInOwnOrg();
      allow create: if creatingInOwnOrg() && isValidId(rejectionId);
      allow update, delete: if false;
    }

    // Written exclusively by the server via the Admin SDK, which bypasses rules.
    // A client that could write its own orgId would defeat all scoping above.
    match /users/{userId} {
      allow get: if isSignedIn() && request.auth.uid == userId;
      allow list, create, update, delete: if false;
    }
  }
}
